# Docker Nexus Environment Configuration
# Copy this file to .env and fill in the values

# LLM Provider Configuration
# Options: openai, ollama, anthropic, gemini
LLM_PROVIDER=ollama

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Configuration (if LLM_PROVIDER=ollama)
# Default: http://localhost:11434 (or http://host.docker.internal:11434 for Docker)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Backend Configuration
PORT=8080
STORE_FILE=./store.json
DEPLOY_DIR=./deployments

# MCP Mode (set to true to run as MCP server instead of HTTP)
MCP_MODE=false
